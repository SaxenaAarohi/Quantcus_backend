# ---- Backend environment variables ----

# MongoDB connection string used by Prisma.
# Local MongoDB (requires a replica set for Prisma transactions, e.g. via `mongod --replSet rs0`)
# or use a free MongoDB Atlas cluster (recommended, easiest):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/product_intelligence?retryWrites=true&w=majority"
DATABASE_URL="mongodb://localhost:27017/product_intelligence"

# Port the Express server listens on.
PORT=5000

# Frontend origin allowed by CORS.
CLIENT_URL=http://localhost:5173
